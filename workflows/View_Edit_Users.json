    {
      "parameters": {
        "jsCode": "if (items.length === 0) {\n  return [{ json: { html: \"<h2>No customers found</h2>\" } }];\n}\n\n// Remove any manual ID column\nconst columns = Object.keys(items[0].json)\n  .filter(col => col !== \"id\");\n\nlet html = `\n<h2>Customers Database</h2>\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\">\n<tr>\n<th>id</th>\n`;\n\nfor (const col of columns) {\n  html += `<th>${col}</th>`;\n}\n\nhtml += `<th>Save</th></tr>`;\n\nfor (const item of items) {\n  const record = item.json;\n  const rowId = record.id; // ✅ correct for Data Table\n\n  html += `<tr><form method=\"POST\" action=\"/webhook/customers\">`;\n\n  html += `\n    <td>\n      ${rowId}\n      <input type=\"hidden\" name=\"rowId\" value=\"${rowId}\" />\n    </td>\n  `;\n\n  for (const col of columns) {\n    html += `\n      <td>\n        <input type=\"text\" name=\"${col}\" value=\"${record[col] ?? \"\"}\" />\n      </td>\n    `;\n  }\n\n  html += `\n    <td>\n      <button type=\"submit\">Save</button>\n    </td>\n  </form></tr>`;\n}\n\nhtml += \"</table>\";\n\nreturn [{ json: { html } }];"
      },
      "type": "n8n-nodes-base.code",
